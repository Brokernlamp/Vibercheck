# Local PostgreSQL connection (the database must exist).
DATABASE_URL=postgres://localhost:5432/vibecheck

# Session signing / IP hashing / MFA encryption. Use 32+ random characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-please-32-bytes-minimum

# Public origin used in invite, reset, and notification links.
APP_URL=http://localhost:3210

# Email delivery (Resend). Without a key, development logs a preview instead
# of sending. Production refuses to start without it.
MAIL_FROM=VibeCheck <no-reply@vibecheck.local>
RESEND_API_KEY=

# Dependency advisories come from the live OSV database (api.osv.dev).
# Set to 1 for an air-gapped install; the bundled advisory set is used instead.
OSV_OFFLINE=0

# Billing: "free" disables checkout, invoices, and paid plan gates.
# "simulated" keeps the test-mode invoice/subscription flow for later.
BILLING_MODE=free

# 1 = freelancer self-service: publish automated results directly.
# 0 = require staff review and client terms before report delivery.
SOLO_MODE=1

# inline = scan inside the Next.js process (development).
# worker = enqueue in Postgres and let `npm run worker` claim the job.
SCAN_EXECUTION=inline

# Show seeded demo accounts on the login page. Defaults to on outside production.
DEMO_MODE=1

# Allow the bundled vulnerable fixture as an intake source. Defaults off in production.
ALLOW_SAMPLE_SOURCE=1

# Snapshot storage. In Docker this is a mounted volume.
DATA_DIR=.data

# Set to 1 only behind a trusted reverse proxy (Caddy/Nginx) that overwrites
# X-Forwarded-For. Used for hashed per-IP rate limiting.
TRUST_PROXY=0

# Retention job window. scripts/purge-sources.ts reads this.
SOURCE_RETENTION_DAYS=30

# Force staff/admin accounts to enroll an authenticator. Defaults on in production.
REQUIRE_STAFF_MFA=0

# debug | info | warn | error
LOG_LEVEL=debug
