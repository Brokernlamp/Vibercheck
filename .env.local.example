# VibeCheck — local development configuration
# Copy to .env.local and adjust as needed.
# NEVER commit .env.local or use these values in production.

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL. Run: createdb vibecheck
DATABASE_URL=postgres://localhost:5432/vibecheck

# ── Session security ──────────────────────────────────────────────────────────
# Must be 32+ characters. Generate: openssl rand -base64 48
# This default is safe for local dev only — change before any shared deployment.
SESSION_SECRET=local-dev-only-change-me-before-any-deployment-32bytes

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Scan execution ────────────────────────────────────────────────────────────
# inline = scan inside the Next.js process (default, no worker needed)
# worker = enqueue in Postgres; run `npm run worker` in a second terminal
SCAN_EXECUTION=inline

# ── Advisory lookups ──────────────────────────────────────────────────────────
# 0 = query live OSV database (requires internet)
# 1 = use bundled offline advisory set (air-gapped / repeatable tests)
OSV_OFFLINE=0

# ── GitHub push scanning (optional) ──────────────────────────────────────────
# Configure a GitHub App with Contents: read and Checks: read/write permissions.
# See the README's "GitHub push scanning" section for setup.
GITHUB_APP_ID=
# Paste the PEM private key; literal \n sequences are accepted.
GITHUB_APP_PRIVATE_KEY=
# Set the same webhook secret in the GitHub App configuration.
GITHUB_WEBHOOK_SECRET=

# ── Local access mode ─────────────────────────────────────────────────────────
# 1 = no login required; every page resolves to a single local operator identity
# 0 = normal sign-in with seeded accounts (run npm run db:seed first)
# Defaults to 1 outside production.
OPEN_ACCESS=1

# ── Demo fixtures ─────────────────────────────────────────────────────────────
# Show seeded demo accounts on the login page.
DEMO_MODE=1

# Allow the bundled vulnerable fixture as an intake source.
ALLOW_SAMPLE_SOURCE=1

# ── Storage ───────────────────────────────────────────────────────────────────
# Local directory for source snapshots. Must be writable by the app process.
DATA_DIR=.data

# ── Retention ─────────────────────────────────────────────────────────────────
SOURCE_RETENTION_DAYS=30

# ── Billing ───────────────────────────────────────────────────────────────────
# free = no checkout, no invoices, no paid-plan gates (correct for local dev)
# simulated = test-mode invoice/subscription flow (no real charges)
BILLING_MODE=free

# Freelancer self-service is on by default. Set to 0 for the analyst-reviewed
# service workflow.
SOLO_MODE=1

# ── Email ─────────────────────────────────────────────────────────────────────
# Without a key, outbound email is logged to .data/mail/outbox.jsonl instead.
# Leave blank for local development.
MAIL_FROM=VibeCheck <no-reply@vibecheck.local>
RESEND_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# 0 = do not require MFA for staff (correct for local dev)
REQUIRE_STAFF_MFA=0

# 0 = do not trust X-Forwarded-For (correct unless behind a known reverse proxy)
TRUST_PROXY=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
