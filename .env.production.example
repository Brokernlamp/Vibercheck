# Copy to .env.production, fill every value, then: chmod 600 .env.production
# Never commit the real file.

# --- Database (Postgres container) ---
POSTGRES_USER=vibecheck
POSTGRES_DB=vibecheck
# Use a long random value and keep it identical inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://vibecheck:replace-with-a-long-random-password@db:5432/vibecheck

# --- Application ---
# Public HTTPS origin and the hostname Caddy should obtain a certificate for.
APP_URL=https://audit.example.com
APP_DOMAIN=audit.example.com
NODE_ENV=production
SESSION_SECRET=replace-with-openssl-rand-base64-48
LOG_LEVEL=info

# --- Email ---
# Verify the domain in Resend first, then create an API key.
MAIL_FROM=VibeCheck <audit@example.com>
RESEND_API_KEY=re_replace_me

# --- Product mode ---
BILLING_MODE=free
SOLO_MODE=1
SCAN_EXECUTION=worker
DEMO_MODE=0
ALLOW_SAMPLE_SOURCE=0
DATA_DIR=/app/.data
TRUST_PROXY=1
SOURCE_RETENTION_DAYS=30
REQUIRE_STAFF_MFA=1

# --- GitHub push scanning (optional; required for webhook/private repo support) ---
# GitHub App ID and PEM private key. Store the key as a deployment secret.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Must match the webhook secret configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=
